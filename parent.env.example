# Copy this file to ../.env (parent folder, outside this git repo)
# and fill with real values. Do not commit real secrets.

# --- Frontend (Vite) ---
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_CLERK_PUBLISHABLE_KEY="pk_test_or_pk_live"
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_or_pk_live"
VITE_STRIPE_PRICE_ID_MONTHLY="price_xxx"
VITE_STRIPE_PRICE_ID_QUARTERLY="price_xxx"
VITE_STRIPE_PRICE_ID_ANNUAL="price_xxx"

# --- Server-side only (do not expose in frontend) ---
STRIPE_SECRET_KEY="sk_test_or_sk_live"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
MAILERLITE_API_KEY="your-mailerlite-api-key"
SYSTEME_IO_API_KEY="your-systeme-io-api-key"
CLAUDE_API_KEY="sk-ant-..."
SUPABASE_ACCESS_TOKEN="sbp_xxx"

# --- Optional CLI / deployment automation ---
# Create at https://vercel.com/account/tokens (Full Account scope).
# Used by instant-site-move/scripts/vercel-*.sh for branch isolation + rollback.
VERCEL_ACCESS_TOKEN="your-vercel-token"
# Find in Vercel project Settings > General (Team ID / Project ID).
VERCEL_ORG_ID="team_xxx"
VERCEL_PROJECT_ID="prj_xxx"
VERCEL_PROJECT_NAME="instant-site-move"
GITHUB_TOKEN="ghp_or_fine_grained_token"
