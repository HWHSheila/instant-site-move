.env.*
!.env.example

# Credentials and secrets
*.key
*.pem
*.p12
credentials.*
secrets.*

# Local agent config (rules stay local; project skills are tracked)
.cursor/*
!.cursor/skills/
!.cursor/skills/**

# Vercel CLI local auth/config (scripts/vercel-env.sh)
.vercel-cli-config/
.vercel-cli-cache/
.vercel-isolation-backup.json

# Supabase local state
supabase/.temp/
